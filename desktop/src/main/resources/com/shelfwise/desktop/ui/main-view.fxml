<?xml version="1.0" encoding="UTF-8"?>

<!-- The main window: the sidebar on the left (E16, E49), the pages in the
     centre. Each page is its own FXML file, loaded by MainController and laid
     into the centre StackPane underneath the toast, so a toast shows on top of
     whichever page is open. -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.shelfwise.desktop.ui.MainController">

    <!-- ============================================================ sidebar -->
    <left>
        <VBox fx:id="sidebar" styleClass="sidebar" prefWidth="210" minWidth="56">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button styleClass="icon-button" onAction="#onToggleSidebar">
                    <graphic><FontIcon iconLiteral="mdi2m-menu" iconSize="20"/></graphic>
                </Button>
                <Label fx:id="appName" text="ShelfWise" styleClass="app-name"/>
            </HBox>
            <Region prefHeight="14"/>

            <ToggleButton fx:id="navBrowse" text="Browse" styleClass="nav-button" maxWidth="Infinity"
                          onAction="#onNavigate">
                <graphic><FontIcon iconLiteral="mdi2b-bookshelf" iconSize="18"/></graphic>
            </ToggleButton>
            <!-- E32: one Add page; Bulk scan is a mode inside it, not its own item. -->
            <ToggleButton fx:id="navAdd" text="Add" styleClass="nav-button" maxWidth="Infinity"
                          onAction="#onNavigate">
                <graphic><FontIcon iconLiteral="mdi2b-book-plus" iconSize="18"/></graphic>
            </ToggleButton>
            <ToggleButton fx:id="navOrganise" text="Organise" styleClass="nav-button" maxWidth="Infinity"
                          onAction="#onNavigate">
                <graphic><FontIcon iconLiteral="mdi2f-file-tree" iconSize="18"/></graphic>
            </ToggleButton>
            <ToggleButton fx:id="navWishlist" text="Wishlist" styleClass="nav-button" maxWidth="Infinity"
                          onAction="#onNavigate">
                <graphic><FontIcon iconLiteral="mdi2h-heart-outline" iconSize="18"/></graphic>
            </ToggleButton>
            <ToggleButton fx:id="navStats" text="Stats" styleClass="nav-button" maxWidth="Infinity"
                          onAction="#onNavigate">
                <graphic><FontIcon iconLiteral="mdi2c-chart-box-outline" iconSize="18"/></graphic>
            </ToggleButton>
            <!-- E49: the Trash count is a badge laid over the button's right end;
                 mouse-transparent, so clicks still reach the button underneath. -->
            <StackPane>
                <ToggleButton fx:id="navTrash" text="Trash" styleClass="nav-button" maxWidth="Infinity"
                              onAction="#onNavigate">
                    <graphic><FontIcon iconLiteral="mdi2d-delete-outline" iconSize="18"/></graphic>
                </ToggleButton>
                <Label fx:id="trashBadge" styleClass="nav-badge" mouseTransparent="true"
                       StackPane.alignment="CENTER_RIGHT">
                    <StackPane.margin><Insets right="10"/></StackPane.margin>
                </Label>
            </StackPane>

            <Region VBox.vgrow="ALWAYS"/>
            <!-- E137: the counts open Stats when clicked. -->
            <VBox fx:id="stats" styleClass="sidebar-stats" spacing="2">
                <Label fx:id="statsBooks" styleClass="muted"/>
                <Label fx:id="statsCopies" styleClass="muted"/>
            </VBox>
            <ToggleButton fx:id="navSettings" text="Settings" styleClass="nav-button" maxWidth="Infinity"
                          onAction="#onNavigate">
                <graphic><FontIcon iconLiteral="mdi2c-cog-outline" iconSize="18"/></graphic>
            </ToggleButton>
            <ToggleButton fx:id="themeToggle" text="Dark" styleClass="nav-button" maxWidth="Infinity"
                          onAction="#onToggleTheme">
                <graphic><FontIcon fx:id="themeIcon" iconLiteral="mdi2w-weather-night" iconSize="18"/></graphic>
            </ToggleButton>
        </VBox>
    </left>

    <!-- ============================================================ centre -->
    <center>
        <StackPane fx:id="centre">
            <!-- E47: success messages, gone after 3 s; with an action (Undo, Show in
                 Browse) they stay 6 s. -Infinity = USE_PREF_SIZE, so the pill hugs its
                 text instead of stretching across the StackPane. -->
            <HBox fx:id="toastBox" styleClass="toast" visible="false" spacing="14" alignment="CENTER_LEFT"
                  maxWidth="-Infinity" maxHeight="-Infinity" StackPane.alignment="BOTTOM_CENTER">
                <StackPane.margin><Insets bottom="70"/></StackPane.margin>
                <Label fx:id="toast" styleClass="toast-text"/>
                <Button fx:id="toastAction" styleClass="toast-action" visible="false" managed="false"/>
                <Button fx:id="toastAction2" styleClass="toast-action" visible="false" managed="false"/>
            </HBox>
        </StackPane>
    </center>
</BorderPane>
